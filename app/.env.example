# Caminho para o diretório de dados do Edge
COUNT_MICROSOFT=C:\\Users\\SEU_USUARIO\\AppData\\Local\\Microsoft\\Edge\\User Data

# Nome do perfil Edge (pode ser: Default, Profile 1, Profile 2, etc)
USER_PROFILE=Profile 1

# Para descobrir seu perfil e caminho exato:
#   1. Abra o Microsoft Edge
#   2. Acesse: edge://version/
#   3. Copie o caminho de "Profile Path" e use aqui

# Dica: Para usar o perfil principal, defina:
# USER_PROFILE=Default